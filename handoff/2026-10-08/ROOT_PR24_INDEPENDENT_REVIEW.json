  "review_conclusions": [
    {
      "area": "four durable panel completion sources",
      "sources": [
        "Worker.complete_inspection",
        "Worker.inspection_source",
        "Worker.inspection_coverage",
        "Worker.inspection_candidates"
      ],
      "finding": "The fixed four-panel checkpoint binds its revision and actual last-settlement digest. An eligible record binds panel, match, request, original lease owner and epoch, unmodified accepted result, explicit coverage, capture receipt, original PNG and strategy JPEG by hashes and fixed durable paths. Record, receipt and both frames are re-read and verified before reuse. Legacy or malformed coverage and missing or changed sources remain ineligible."
    },
    {
      "area": "one current business_resume exact reuse",
      "sources": [
        "Worker.prepare_inspection_resume",
        "Worker.review_business_resume",
        "Worker.save_business"
      ],
      "finding": "The current resume must acknowledge the exact offered candidate map, checkpoint revision and settlement digest. Reuse, changed and unknown form a disjoint complete partition of the four panels; reused digests must equal eligible source records. Explicit continuity basis is bound to this current snapshot, requires no unobserved interval for reuse, and cannot clear known pending history. New or unknown settlement and omitted resume evidence clear eligibility. Business CAS saves the review and checkpoint change before enabling in-memory reuse."
    },
    {
      "area": "current-page scheduling",
      "sources": [
        "Worker.schedule_inspections",
        "Worker.tick"
      ],
      "finding": "After current resume acceptance, scheduling selects the first missing panel. It inspects directly if already on that panel, enters it from the lobby, or returns to the lobby from another panel. All four current approvals are required before new_match. Pending rewards and business resume remain ahead of panel scheduling; unknown and modal pages retain the existing fail-closed route."
    },
    {
      "area": "settlement atomic invalidation",
      "sources": [
        "Worker.confirm_match_result",
        "Worker.save_business",
        "Worker.initialize_business"
      ],
      "finding": "A confirmed settlement prepares completed-match state, the new settlement and an empty inspection checkpoint in one proposed business document and one guarded CAS write. Counters, consumed settlement state and in-memory flags update only after that write succeeds. New-business initialization clears approvals and records; a lobby new_match intent alone does not allocate or migrate a business."
    },
    {
      "area": "pending and read-only capture watermark",
      "sources": [
        "Worker.inspection_readonly_watermark",
        "Worker.complete_inspection",
        "Worker.save_business"
      ],
      "finding": "Fresh completion requires no current unresolved receipt, retains all original receipt ids, and accepts only newly added successful read-only observe/wait receipts without handoff, attempted input or unknown action. The current capture must be new in the watermark. Exact reuse separately refuses both current and historical pending evidence; fresh completion does not erase older pending history."
    },
    {
      "area": "stop epoch ownership and CAS",
      "sources": [
        "Worker.save_business",
        "Worker.commit_guard",
        "Worker.review_business_resume",
        "Worker.execute_plan"
      ],
      "finding": "Checkpoint mutations retain the business.lock revision CAS and exact current lease owner chat/run/worker PID/creation binding. The existing manual/stop/epoch/request tuple, deadline, foreground and state guards remain applied before guarded publication. Epoch change revokes current approvals while leaving historical evidence auditable. Candidate code adds no direct game-input or old-command replay route."
    },
    {
      "area": "cross-file transaction boundary",
      "sources": [
        "handoff/2026-10-08/INSPECTION_CHECKPOINT.md",
        "Worker.save_business",
        "Worker.commit_guard"
      ],
      "finding": "The business CAS and final pending/stop checks do not form one atomic transaction with a separate Entry publication. The implementation and its handoff preserve this limit and rely on the existing single input writer and manual-handoff guard. This review supplies source eligibility only; no active-run launch or competing-writer experiment was performed."
    }
