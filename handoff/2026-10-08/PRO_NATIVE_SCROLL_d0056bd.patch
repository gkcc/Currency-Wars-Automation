+def _frame(image, rows, *, page='unknown', native_name=None, declaration=None):
+    output = io.BytesIO()
+    image.save(output, format='PNG')
+    payload = output.getvalue()
+    observation = dict(page=page, rows=rows,
+        fields=dict(stage='1-1' if page == 'preparation' else None,
+                    coins=None, level=None, xp=None, deployed=None),
+        semantic={}, elapsed_ms=0., snapshot_id=hashlib.sha256(payload).hexdigest(),
+        fingerprint=perception.fingerprint(image),
+        read_contract=dict(version=runner.READ_CONTRACT_VERSION, effective_scope='full', unread=[]))
+    return dict(payload=payload, observation=observation, native_name=native_name,
+                declaration=declaration)
+
