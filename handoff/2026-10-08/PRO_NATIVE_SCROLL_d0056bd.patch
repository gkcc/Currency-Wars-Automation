+def native_canvas(name='guard-source', *, mutation=None, root_counter_boxes=False):
+    """Unedited crop at native coordinates; mutation means a declared negative."""
+    unused, ocr, payloads = native_sources()
+    with Image.open(io.BytesIO(payloads[name + '.png'])) as crop:
+        if crop.format != 'PNG' or crop.size != (1380, 709):
+            raise ValueError('native crop dimensions changed')
+        image = Image.new('RGB', (1920, 1080), (45, 45, 45))
+        image.paste(crop.convert('RGB'), CROP_BOUNDS[:2])
+    rows = copy.deepcopy(ocr['frames'][name]['rows'])
+    declaration = 'native crop plus declared outer padding; archived actual offline OCR'
+    if root_counter_boxes:
+        # These are the separately supplied original ROOT OCR bounds, not a
+        # correction to the independently replayed offline OCR row set.
+        boxes = {'guard-source': [1462, 326, 1510, 357],
+                 'scroll-one-before': [1462, 326, 1510, 357],
+                 'scroll-one-after': [1462, 297, 1510, 327]}
+        if name not in boxes:
+            raise ValueError('no ROOT counter-box metadata for this replay variant')
+        [row for row in rows if row['text'] == '0/2'][0]['box'] = boxes[name]
+        declaration += '; 0/2 box separately sourced from ROOT diagnosis'
+    if mutation:
+        draw = ImageDraw.Draw(image)
+        target = next((row for row in rows if row['text'] == '0/2'), None)
+        if mutation == 'cover':
+            x, y, right, bottom = target['box']
+            draw.rectangle([x, y, right-1, bottom-1], fill=(45, 45, 45))
+        elif mutation == 'text':
+            target.update(text='1/2', raw_text='1/2', normalization_basis=None)
+            x, y, unused_right, bottom = target['box']
+            draw.rectangle([x+5, y+5, x+12, bottom-5], fill=(220, 220, 220))
+        elif mutation == 'overlay':
+            draw.rectangle([930, 460, 1170, 555], fill=(80, 80, 80))
+            rows.append(dict(text='是否确认', raw_text='是否确认', normalization_basis=None,
+                             confidence=.99, box=[950, 480, 1140, 525]))
+        elif mutation == 'occluded_input_center':
+            x, y, right, bottom = target['box']
+            cx, cy = round((x+right)/2), round((y+bottom)/2)
+            draw.rectangle([cx-4, cy-4, cx+4, cy+4], fill=(220, 40, 40))
+        elif mutation == 'missing_complete_marker':
+            # This source row's real glyphs remain inside the viewport after
+            # -30. An OCR rectangle touching its safety margin is not clipping.
+            draw.rectangle([811, 279, 1080, 316], fill=(45, 45, 45))
+            rows = [row for row in rows if row['text'] != '累计使用2次特权赋予']
+        else:
+            raise ValueError('unknown declared mutation')
+        declaration += '; DECLARED NEGATIVE mutation=' + mutation
+    result = _frame(image, rows, native_name=name, declaration=declaration)
+    image.close()
+    return result
