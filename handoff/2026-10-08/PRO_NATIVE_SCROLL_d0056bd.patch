+def native_sources():
+    payloads = {name: (EVIDENCE_DIR / name).read_bytes() for name in ASSET_SHA256}
+    for name, payload in payloads.items():
+        if hashlib.sha256(payload).hexdigest() != ASSET_SHA256[name]:
+            raise ValueError('frozen native scroll asset changed: ' + name)
+    diagnosis = json.loads(payloads['diagnosis.json'].decode('utf-8-sig'))
+    ocr = json.loads(payloads['offline-ocr-replay.json'].decode('utf-8'))
+    if (diagnosis['candidate'] != PARENT or diagnosis['guard_failure_actual_frame_retained'] is not False
+            or ocr['basis_commit'] != PARENT or ocr['native_root_ocr_output'] is not False):
+        raise ValueError('native scroll provenance is not the frozen PR32 evidence')
+    for name, value in diagnosis['frames'].items():
+        if (value['crop_bounds'] != CROP_BOUNDS or value['resized'] is not False
+                or value['pixels_edited'] is not False
+                or value['crop_sha256'] != ASSET_SHA256[name + '.png']
+                or ocr['frames'][name]['crop_sha256'] != value['crop_sha256']):
+            raise ValueError('native crop geometry or OCR provenance changed')
+    return diagnosis, ocr, payloads
