+def action_for(request, *, label='0/2', delta=-120):
+    rows = request['observation']['rows']
+    target = [row for row in rows if row['text'] == label]
+    chapter = [row for row in rows if row['text'] == '第4章']
+    if len(target) != 1 or len(chapter) != 1:
+        raise ValueError('replay action requires actual unique row')
+    x, y, right, bottom = target[0]['box']
+    proof = dict(control_id=guards.TASK_LIST_SCROLL_CONTROL, source='observed_screen',
+        snapshot_id=request['snapshot_id'], capture_request_id=request['observation']['capture_request_id'],
+        frame_id=request['observation']['frame_id'], text=label, bounds=target[0]['box'].copy(),
+        chapter_text='第4章', chapter_bounds=chapter[0]['box'].copy(), list_bounds=LIST_BOUNDS.copy())
+    return dict(type='scroll', args=[(x+right)/2, (y+bottom)/2, delta], expected_page='unknown',
+        guard_texts=['创业指南', '第4章', label], target_evidence=proof,
+        reason='当前完整唯一列表文字中心的一次受检滚动；以原生多行和滚动条位移复核')
