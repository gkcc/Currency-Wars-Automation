+def manual_job(bundle, *, reply=None, after_queue=None):
+    kwargs = job_kwargs(bundle, reply=reply)
+    queued = steps.submit(bundle.runtime, bundle.owner, bundle.control, **kwargs)
+    if queued['status'] != 'queued':
+        raise AssertionError('manual step did not queue: ' + repr(queued))
+    if after_queue is not None:
+        after_queue()
+    if not steps.process(bundle.worker):
+        raise AssertionError('owning Worker did not consume its queued manual step')
+    return steps.submit(bundle.runtime, bundle.owner, bundle.control, **kwargs), kwargs
