+def _candidate_value_modifiers(state, policy=None, valid_entities=None):
+    """Read declared comparison assumptions from policy only.
+
+    Assumptions affect comparison only. They never become observed state and
+    never authorize execution.
+    """
+    policy = _dict(policy)
+    raw = policy.get('candidate_value_modifiers', [])
+    diagnostics = []
+    accepted = {}
+    if raw is None:
+        return accepted, diagnostics
+    if not isinstance(raw, list) or len(raw) > 32:
+        return accepted, ['candidate_value_modifiers_invalid']
+    binding = _dict(state.get('binding'))
+    valid_entities = _dict(valid_entities)
+    for index, item in enumerate(raw):
+        if not isinstance(item, dict):
+            diagnostics.append(f'{index}:not_object')
+            continue
+        required = ('request_id', 'match_id', 'resume_epoch', 'snapshot_id',
+                    'entity_ref', 'utility_multiplier')
+        if any(k not in item for k in required):
+            diagnostics.append(f'{index}:missing_required_field')
+            continue
+        if type(item.get('resume_epoch')) is not type(binding.get('resume_epoch')):
+            diagnostics.append(f'{index}:epoch_type_mismatch')
+            continue
+        if (item.get('request_id') != binding.get('request_id')
+                or item.get('match_id') != binding.get('match_id')
+                or item.get('resume_epoch') != binding.get('resume_epoch')):
+            diagnostics.append(f'{index}:binding_mismatch')
+            continue
+        if item.get('snapshot_id') != state.get('snapshot_id'):
+            diagnostics.append(f'{index}:snapshot_mismatch')
+            continue
+        if item.get('status') != 'hypothetical':
+            diagnostics.append(f'{index}:not_hypothetical')
+            continue
+        entity = valid_entities.get(item.get('entity_ref'))
+        if entity is None:
+            diagnostics.append(f'{index}:entity_not_current')
+            continue
+        if item.get('role_id') is not None and item.get('role_id') != entity.get('role_id'):
+            diagnostics.append(f'{index}:role_mismatch')
+            continue
+        value = item.get('utility_multiplier')
+        if type(value) not in (int, float) or isinstance(value, bool):
+            diagnostics.append(f'{index}:invalid_multiplier_type')
+            continue
+        if not math.isfinite(value) or value <= 0 or value > 2:
+            diagnostics.append(f'{index}:invalid_multiplier')
+            continue
+        if item['entity_ref'] in accepted:
+            diagnostics.append(f'{index}:duplicate_entity')
+            continue
+        accepted[item['entity_ref']] = {
+            'utility_multiplier': float(value),
+            'source': 'declared_hypothetical',
+        }
+    return accepted, diagnostics
